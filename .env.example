# Flask
SECRET_KEY=change-me
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false
PRODUCTION=false
SESSION_COOKIE_SECURE=false

# AI provider: ollama for local development, groq for production
AI_PROVIDER=ollama

# Ollama local development
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_VISION_MODEL=qwen3:8b
OLLAMA_TIMEOUT=60
START_OLLAMA_WARMUP=true

# Groq production
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview
GROQ_TIMEOUT=45

# Weather
WEATHER_API_KEY=

# Email OTP over HTTPS, recommended on Render/Railway
RESEND_API_KEY=
RESEND_FROM=DENZ <onboarding@resend.dev>

# Optional Gmail SMTP, works locally but may be blocked by free hosting tiers
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Optional Twilio SMS OTP
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Admin defaults
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_EMAIL=
ADMIN_PHONE=

# Local testing only. Never enable in production.
OTP_RETURN_CODE=false
